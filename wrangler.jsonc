{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leafing-well-preview",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": false },
}
