{
  "name": "leafing-well",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --local --port 8787",
    "test": "node --test tests/build.test.mjs",
    "test:ui": "npm run build && playwright test",
    "lint": "node scripts/check.mjs",
    "check": "npm run lint && npm test && npm run build && wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler versions upload --preview-alias leafing-well",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "prettier": "^3.9.10",
    "wrangler": "^4.0.0"
  }
}
